{
  "name": "@lws-stream/server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Shared Web-standard server for the LWS NDJSON/CBOR-LD stream demo",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./cborld": "./src/cborld.ts",
    "./notifications": "./src/notifications.ts",
    "./adapters/cloudflare": "./adapters/cloudflare.ts",
    "./adapters/vercel": "./adapters/vercel.ts"
  },
  "scripts": {
    "dev": "node --watch adapters/node.ts",
    "start": "node adapters/node.ts",
    "generate:fixtures": "node scripts/generate-fixtures.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@digitalbazaar/cborld": "^8.1.0",
    "@hono/node-server": "^2.1.5",
    "cborg": "^6.1.4",
    "hono": "^4.13.13",
    "rdfjs-jelly": "^0.1.6"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
