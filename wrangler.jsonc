{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cbor-ld-stream-demo",
  "main": "packages/server/adapters/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./packages/client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/notifications", "/health", "/contexts/*"]
  },
  "observability": {
    "enabled": true
  }
}
